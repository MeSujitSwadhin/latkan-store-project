# Copy to .env.local and fill in ONLY verified business details.

# Verified WhatsApp business number in international format, digits only (e.g. 919xxxxxxxxx).
# Leave empty to hide every WhatsApp action (no fake numbers are ever shown).
NEXT_PUBLIC_WHATSAPP_NUMBER=

# "whatsapp" (Mode A, default) or "checkout" (Mode B — requires a configured payment provider).
NEXT_PUBLIC_COMMERCE_MODE=whatsapp

# "true" shows sections that are still awaiting business verification (custom orders,
# sample catalogue) with a visible "preview" notice. Set to "false" for public launch
# until the business confirms those details.
NEXT_PUBLIC_PREVIEW_MODE=true

# Public site URL used for metadata / sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
